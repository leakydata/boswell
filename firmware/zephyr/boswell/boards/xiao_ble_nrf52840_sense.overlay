/*
 * The board declares the PDM pins and clock source but leaves the peripheral
 * disabled, so an application that wants the microphone opts in here. Nothing
 * about the wiring is repeated -- that already lives in the board definition.
 */

&pdm0 {
	status = "okay";
};

/ {
	chosen {
		/* Route console and logs to USB CDC so a board with no debug
		 * probe can still be diagnosed. */
		zephyr,console = &cdc_acm_uart0;
		zephyr,shell-uart = &cdc_acm_uart0;
	};
};

&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

/*
 * Power the microphone.
 *
 * The board's own DTS declares the mic's supply as a regulator-fixed node on
 * P1.10, but -- unlike the IMU's, right next to it -- without regulator-boot-on,
 * and nothing references it: the PDM driver has no regulator support and the
 * pdm0 node has no supply property. So the regulator is never enabled, the
 * microphone stays unpowered, and PDM samples a floating pin. That reads as
 * full-scale noise, which is exactly the 99.7% clipping measured on the first
 * Zephyr captures. Enable it the same way the board enables the IMU's.
 */
&{/msm261d3526hicpm-c-en} {
	compatible = "regulator-fixed-sync", "regulator-fixed";
	regulator-boot-on;
	regulator-always-on;
	startup-delay-us = <3000>;
};

/*
 * Hold the IMU's supply on. The board declares this one with regulator-boot-on
 * but not regulator-always-on, so nothing keeps a reference to it and the
 * part can end up unpowered -- WHO_AM_I reads back 0xFF on both addresses.
 * Same failure the microphone had, one node over.
 */
&{/lsm6ds3tr-c-en} {
	regulator-always-on;
};

/*
 * Battery sense on AIN7 (P0.31). Gain 1/6 against the internal 0.6 V
 * reference gives a 3.6 V full scale at the pin, which the 1M/510k divider
 * maps to about 10.6 V of battery -- far more headroom than a single lithium
 * cell needs, and it keeps the reading independent of VDD as the cell drains.
 */
&adc {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@7 {
		reg = <7>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN7>;
		zephyr,resolution = <12>;
	};
};

/ {
	zephyr,user {
		io-channels = <&adc 7>;
	};
};

/*
 * PWM on the three LED channels, for brightness control.
 *
 * The board's stock pwm0_default maps PWM_OUT0 to P0.17, which is not an LED
 * at all -- it is the BQ25101's ~CHG output, which this firmware reads to
 * report charging. Using the shipped pwm-led0 alias would have driven an
 * output onto an input the battery code depends on. These are the real LED
 * pins: red P0.26, green P0.30, blue P0.06.
 *
 * The RGB LED is common anode, so a channel lights when its pin is pulled
 * low; nordic,invert makes a rising duty cycle mean a brighter LED.
 */
&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0_leds>;
	pinctrl-1 = <&pwm0_leds_sleep>;
	pinctrl-names = "default", "sleep";
};

&pinctrl {
	pwm0_leds: pwm0_leds {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 26)>,
				<NRF_PSEL(PWM_OUT1, 0, 30)>,
				<NRF_PSEL(PWM_OUT2, 0, 6)>;
			nordic,invert;
		};
	};

	pwm0_leds_sleep: pwm0_leds_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 26)>,
				<NRF_PSEL(PWM_OUT1, 0, 30)>,
				<NRF_PSEL(PWM_OUT2, 0, 6)>;
			nordic,invert;
			low-power-enable;
		};
	};
};

/ {
	boswell_leds {
		compatible = "pwm-leds";
		/* Inverted, measured rather than reasoned about. With NORMAL the
		 * pins read low at zero duty, and low lights a common-anode LED --
		 * so "off" came out magenta and sat there, which is what the board
		 * showed for days. Read back with "boswell led probe". */
		pwm_r: pwm_r { pwms = <&pwm0 0 PWM_MSEC(20) PWM_POLARITY_INVERTED>; };
		pwm_g: pwm_g { pwms = <&pwm0 1 PWM_MSEC(20) PWM_POLARITY_INVERTED>; };
		pwm_b: pwm_b { pwms = <&pwm0 2 PWM_MSEC(20) PWM_POLARITY_INVERTED>; };
	};
};

/*
 * The push button.
 *
 * A momentary switch between the pin and ground -- no external resistor,
 * because the internal pull-up holds the line high and a press pulls it low.
 *
 * D7 (P1.12) is chosen because it is free in every build this project has.
 * The Audio BFF takes D8/D9/D10 for the card's SPI and D0 for its chip
 * select, and the speaker wants D1/D2/D3 for I2S; D4 and D5 are the header's
 * I2C pair, and D6/D7 its UART pair, which nothing uses here because the
 * console is USB CDC. That leaves D6 and D7, and D7 is the corner pin --
 * easiest of the lot to get a soldering iron onto.
 *
 * Declared unconditionally, including on boards with no switch fitted. An
 * unconnected pin is held high by the pull-up, which reads as "not pressed",
 * so the cost of it being here is one configured input.
 *
 * To move it: change the pin below. Nothing else refers to it.
 */
/*
 * The board enables uart0 and its pinctrl claims P1.11 and P1.12 -- D6 and
 * D7 -- as TX and RX. Nothing here uses it: the console and the shell are
 * both on USB CDC, declared above. Left enabled it simply owns two header
 * pins, and the button on D7 was configured, interrupt-enabled, and never
 * saw an edge, because the UART peripheral had the pin.
 *
 * Disabled rather than moving the button, because by the time this was found
 * the switch was soldered to D7 and hardware that already exists beats a
 * pin choice that only exists in a file. If a hardware UART is ever wanted
 * -- and it would be worth having, since USB CDC cannot deliver a panic
 * banner -- it can go on D4/D5.
 */
&uart0 {
	status = "disabled";
};

/ {
	buttons {
		compatible = "gpio-keys";
		boswell_button: button_0 {
			gpios = <&gpio1 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "Boswell button";
		};
	};

	aliases {
		sw0 = &boswell_button;
	};
};
